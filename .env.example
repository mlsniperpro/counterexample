# Nebius Token Factory (OpenAI-compatible). Without a key the app runs in deterministic replay mode.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Model ids: confirm against the Token Factory model list before the demo.
MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_FAST=nvidia/nemotron-3-super-120b-a12b
# Optional USD per 1M tokens override, e.g. {"nvidia/Nemotron-3-Ultra-550b-a55b":{"in":1,"out":3}}
MODEL_PRICES=

# Tavily research stage (optional)
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Sandbox: any Judge0-compatible API. Without it, the dev-only local executor is used (refused in production).
JUDGE0_URL=
JUDGE0_TOKEN=
# Set only for RapidAPI-hosted Judge0 (then JUDGE0_TOKEN is the RapidAPI key)
JUDGE0_RAPIDAPI_HOST=
# "bearer" sends Authorization: Bearer <JUDGE0_TOKEN> (a Nebius Serverless endpoint running sandbox/; see docs/NEBIUS-SANDBOX.md)
JUDGE0_AUTH=
# Override language ids if your Judge0 has newer runtimes (defaults: python 71, javascript 63)
JUDGE0_LANG_PYTHON=
JUDGE0_LANG_JAVASCRIPT=
# WARNING: the local executor is not a sandbox. Pasted code runs as the server's user and can read the server's
# environment (your keys). Set this to 1 only for a local demo, never on a public deployment.
ALLOW_LOCAL_EXECUTOR=

# Public deployment guards (per server instance; see README "Load and limits")
RATE_LIMIT_PER_HOUR=10
# Replay attacks (no NEBIUS_API_KEY) cost no model money, so they get a higher per-IP hourly limit.
REPLAY_RATE_LIMIT_PER_HOUR=120
# Use the right-most X-Forwarded-For entry for per-IP limits (Vercel's own headers are used automatically). Only behind a proxy that appends it.
# TRUST_PROXY_HEADERS=1
ATTACKS_PER_IP_PER_DAY=30
DAILY_SPEND_CAP_USD=2
MAX_CONCURRENT_ATTACKS=4
# Force replay mode even with a key
REPLAY=
