# Nebius Token Factory (OpenAI-compatible). Without a key the app runs in deterministic replay mode.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Model ids: confirm against the Token Factory model list before the demo.
MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_FAST=nvidia/nemotron-3-super-120b-a12b
# Optional USD per 1M tokens override, e.g. {"nvidia/Nemotron-3-Ultra-550b-a55b":{"in":1,"out":3}}
MODEL_PRICES=

# Tavily research stage (optional)
TAVILY_API_KEY=

# Sandbox: any Judge0-compatible API. Without it, the dev-only local executor is used (refused in production).
JUDGE0_URL=
JUDGE0_TOKEN=
# Set only for RapidAPI-hosted Judge0 (then JUDGE0_TOKEN is the RapidAPI key)
JUDGE0_RAPIDAPI_HOST=
# Override language ids if your Judge0 has newer runtimes (defaults: python 71, javascript 63)
JUDGE0_LANG_PYTHON=
JUDGE0_LANG_JAVASCRIPT=
ALLOW_LOCAL_EXECUTOR=

# Public deployment guards
RATE_LIMIT_PER_HOUR=10
DAILY_SPEND_CAP_USD=2
# Force replay mode even with a key
REPLAY=
